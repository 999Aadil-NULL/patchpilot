# --- Role configs (OpenAI-compatible endpoints) ---
# Presets:
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/   (model id from AI Studio)
#   Groq:   https://api.groq.com/openai/v1
#   Ollama: http://localhost:11434/v1   key=ollama  model=qwen2.5-coder:7b
#   Meta:   <fill at final stage>
PLANNER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
PLANNER_API_KEY=
PLANNER_MODEL=gemini-3-flash-preview

CODER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CODER_API_KEY=
CODER_MODEL=gemini-3-flash-preview

LLM_CACHE=1
LLM_TIMEOUT_S=120
MAX_ATTEMPTS=3

# Optional
# GEMINI_API_KEY=            # if set, unset PLANNER_*/CODER_* fields fall back to Gemini
# PLANNER_REASONING_EFFORT=  # low|medium|high — passed as reasoning_effort for thinking models
# CODER_REASONING_EFFORT=
LLM_MAX_TOKENS_FLOOR=16384   # min max_tokens sent (thinking tokens share this budget)
